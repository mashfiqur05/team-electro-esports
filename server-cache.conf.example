# Nginx: include this inside the server { } block.
location ~* \.(?:css|js|png|jpe?g|webp|avif|svg|woff2?)$ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
}

# Apache/.htaccess equivalent:
# <IfModule mod_headers.c>
#   <FilesMatch "\.(css|js|png|jpe?g|webp|avif|svg|woff2?)$">
#     Header set Cache-Control "public, max-age=31536000, immutable"
#   </FilesMatch>
# </IfModule>

# Cloudflare:
# Create a Cache Rule for the static extensions above and set
# Browser Cache TTL to "1 year". Use hashed filenames or update the
# existing query-string version (for example, app.js?v=4) when deploying.
